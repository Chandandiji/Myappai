rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMediaItem(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.type is string && (data.type == 'song' || data.type == 'youtube' || data.type == 'video' || data.type == 'audio' || data.type == 'pdf' || data.type == 'photo' || data.type == 'note') &&
             (!('url' in data) || (data.url is string && data.url.size() <= 2000)) &&
             (!('content' in data) || (data.content is string && data.content.size() <= 20000)) &&
             (!('artistOrAuthor' in data) || (data.artistOrAuthor is string && data.artistOrAuthor.size() <= 200)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20 && (data.tags.size() == 0 || data.tags[0] is string))) &&
             (!('isFavorite' in data) || data.isFavorite is bool) &&
             (!('playlistIds' in data) || (data.playlistIds is list && data.playlistIds.size() <= 50 && (data.playlistIds.size() == 0 || data.playlistIds[0] is string))) &&
             (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2000)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidPlaylist(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('itemCount' in data) || (data.itemCount is int && data.itemCount >= 0)) &&
             (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 2000)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 30)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow delete: if isOwner(userId);

      match /media_items/{itemId} {
        allow get, delete: if isOwner(userId) && isValidId(itemId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(itemId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'title', 'type', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'type', 'url', 'content', 'artistOrAuthor', 'category', 'tags', 'isFavorite', 'playlistIds', 'thumbnailUrl', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidMediaItem(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(itemId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'type', 'url', 'content', 'artistOrAuthor', 'category', 'tags', 'isFavorite', 'playlistIds', 'thumbnailUrl', 'updatedAt']) &&
                         isValidMediaItem(incoming());
      }

      match /playlists/{playlistId} {
        allow get, delete: if isOwner(userId) && isValidId(playlistId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(playlistId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'name', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'description', 'itemCount', 'coverUrl', 'color', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidPlaylist(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(playlistId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'itemCount', 'coverUrl', 'color', 'updatedAt']) &&
                         isValidPlaylist(incoming());
      }
    }
  }
}
